# ── 배포자 / 서명자 개인키 (0x 접두사 없이 입력) ─────────────────────────────────
# Ganache: GUI의 계정 키 복사, Sepolia: MetaMask 내보내기
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
OWNER2_PRIVATE_KEY=your_owner2_private_key_here
OWNER3_PRIVATE_KEY=your_owner3_private_key_here

# ── 서명자 주소 (선택 — 미입력 시 위 키에서 자동 추출) ──────────────────────────
# OWNER1_ADDRESS=0xYourOwner1Address
# OWNER2_ADDRESS=0xYourOwner2Address
# OWNER3_ADDRESS=0xYourOwner3Address

# ── 최소 서명 수 (기본값: 2) ──────────────────────────────────────────────────
# REQUIRED_SIGS=2

# ── RPC URL ───────────────────────────────────────────────────────────────────
# Ganache GUI 기본값
GANACHE_URL=http://127.0.0.1:7545
GANACHE_CHAIN_ID=1337

# Sepolia — Infura / Alchemy / QuickNode 등 RPC URL
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# ── Etherscan (선택 — Sepolia 컨트랙트 검증용) ────────────────────────────────
# ETHERSCAN_API_KEY=your_etherscan_api_key_here
